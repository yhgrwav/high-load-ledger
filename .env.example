DB_SUPER_USER=super_user
DB_SUPER_PASSWORD=password
DB_USER=default_user
DB_PASSWORD=password

DB_NAME=ledger
DB_HOST=127.0.0.1
DB_PORT=5433
DB_SSL_MODE=disable
DB_MAX_CONNS=300
DB_MIN_CONNS=80

PG_MAX_CONNECTIONS=1200
PG_SHARED_BUFFERS=1GB
# async commit: не ждём fsync WAL перед ответом клиенту постгре. Окно потери - последние
# ~200мс (wal_writer_delay) незакоммиченных транзакций при падении процесса Postgres (не
# при падении клиента/сети - COMMIT в самой БД всё равно атомарен). Ощутимо снижает
# write-latency под нагрузкой, это единственный ещё не опробованный infra-рычаг из перф-разбора.
PG_SYNCHRONOUS_COMMIT=off

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=password
REDIS_DB=0
REDIS_POOL_SIZE=2000
REDIS_MIN_IDLE_CONNS=300
REDIS_POOL_TIMEOUT=2s
REDIS_TRANSACTION_TTL=67m

# idempotency redis
IDEMPOTENCY_REDIS_HOST=127.0.0.1
IDEMPOTENCY_REDIS_PORT=6377
IDEMPOTENCY_REDIS_PASSWORD=password
IDEMPOTENCY_REDIS_DB=0
IDEMPOTENCY_REDIS_POOL_SIZE=2000
IDEMPOTENCY_REDIS_MIN_IDLE_CONNS=300
IDEMPOTENCY_REDIS_POOL_TIMEOUT=3s
IDEMPOTENCY_REDIS_TRANSACTION_TTL=67m


GRPC_PORT=50051
ENVIRONMENT=development

SERVICE_NAME=ledger
METRICS_PORT=6767
LOG_LEVEL=warn
ADD_SOURCE=false
IS_JSON=true


POSTING_WORKER_NAME=balance_verifier
POSTING_WORKER_BATCH_SIZE=200
POSTING_WORKER_BACKOFF=10s


KAFKA_BROKERS=kafka:29092
KAFKA_TOPIC=completed_transactions
KAFKA_CONSUMER_GROUP=ledger-stats-cache


#GATEWAY_REPLICAS=2


LOAD_GEN_WORKING=true

USERS_AMOUNT=100000
VALID_RPS=10000
INVALID_RPS=100
INVALID_CURRENCY_RPS=100
STATS_RPS=100
LOAD_DURATION=5m
LOAD_BOOTSTRAP_WORKERS=80
LOAD_TX_WORKERS=2000
LOADGEN_GRPC_CONNECTIONS=8

BOOTSTRAP_MAX_ERROR_PCT=33
LOADGEN_GRPC_ADDR=gateway:8085
LOADGEN_METRICS_PORT=9092